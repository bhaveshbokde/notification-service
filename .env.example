# =============================================================================
#  Notification Service — environment template
# =============================================================================
#  This file is a TEMPLATE and is committed. It contains no real secrets.
#
#  The real file is `.env`, which is git-ignored. Generate it with:
#
#      sudo bash scripts/provision-db.sh
#
#  which creates the database role and databases, invents a password, a JWT
#  signing key and a development administrator password, and writes `.env` with
#  mode 0600. You should not need to edit it by hand, and you must never commit
#  it.
#
#  Spring loads `.env` via `spring.config.import` in application.yml. That path
#  resolves against the WORKING DIRECTORY, not the jar — so if you run from an
#  IDE, set the run configuration's working directory to the project root or
#  none of these values resolve and startup fails on the JWT key length check.
#  See docs/TROUBLESHOOTING.md.
# =============================================================================

# -----------------------------------------------------------------------------
#  Database
# -----------------------------------------------------------------------------
NOTIFICATION_DB_URL=jdbc:postgresql://127.0.0.1:5432/notification_db
NOTIFICATION_DB_USERNAME=notification_app

# Generated by provision-db.sh. The role is created NOSUPERUSER NOCREATEDB
# NOCREATEROLE and owns only its own two databases — it cannot reach anything
# else on the server.
NOTIFICATION_DB_PASSWORD=replace-me-run-scripts-provision-db-sh

# A separate database for the integration tests. They DELETE between test
# classes, so pointing this at the development database would destroy work in
# progress.
NOTIFICATION_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/notification_test_db

# -----------------------------------------------------------------------------
#  Kafka
# -----------------------------------------------------------------------------
# Host and port of the broker. With docker-compose.yml the application uses
# `kafka:9092` (the compose service name); a client on the host uses
# `localhost:29092`.
NOTIFICATION_KAFKA_BOOTSTRAP=127.0.0.1:9092
NOTIFICATION_KAFKA_GROUP=notification-service

# Topic names. Namespaced and versioned so a breaking payload change can run
# alongside the old topic during a migration.
NOTIFICATION_TOPIC=notifications.requested.v1
NOTIFICATION_RETRY_TOPIC=notifications.requested.v1.retry
NOTIFICATION_DLT_TOPIC=notifications.requested.v1.DLT

# -----------------------------------------------------------------------------
#  Redis
# -----------------------------------------------------------------------------
NOTIFICATION_REDIS_HOST=127.0.0.1
NOTIFICATION_REDIS_PORT=6379
NOTIFICATION_REDIS_PASSWORD=

# -----------------------------------------------------------------------------
#  JWT signing
# -----------------------------------------------------------------------------
# At least 32 bytes (256 bits) of key material — the HS256 minimum from
# RFC 7518 §3.2. Accepts base64 or a long raw string; a short value fails at
# startup rather than at the first login in production.
#
# Generate one with:
#     head -c 64 /dev/urandom | base64 | tr -d '\n'
NOTIFICATION_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-key-material

NOTIFICATION_JWT_ISSUER=notification-service
NOTIFICATION_JWT_ACCESS_TTL=PT60M

# -----------------------------------------------------------------------------
#  Development API consumer
# -----------------------------------------------------------------------------
# Created once at startup, ONLY when both values are set AND the active profile
# is not `prod`. The migrations seed no users at all, so there is no committed
# credential anywhere in this repository.
#
# Needed because there is no registration endpoint by design — a service that
# can send email and SMS to arbitrary recipients must not accept self-signup.
NOTIFICATION_ADMIN_USERNAME=
NOTIFICATION_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
#  Providers (SIMULATED — no real email or SMS is sent)
# -----------------------------------------------------------------------------
# true  = simulate locally. No SMTP, no gateway, no cost. The default.
# false = requires real provider adapters to be registered; the application
#         refuses to start with `true` under the `prod` profile.
NOTIFICATION_SIMULATION=true

# Artificial provider latency, so the asynchronous pipeline is observable.
NOTIFICATION_SIM_LATENCY=PT0.05S

# Probability of a spontaneous transient failure, 0.0-1.0. Zero by default: a
# random failure rate makes a test suite flaky and a demo unreproducible.
# Scripted per-recipient outcomes are used instead — see docs/API-EXAMPLES.md.
NOTIFICATION_SIM_FAILURE_RATE=0.0

# -----------------------------------------------------------------------------
#  Rate limiting
# -----------------------------------------------------------------------------
NOTIFICATION_RATE_LIMIT_ENABLED=true
NOTIFICATION_RATE_LIMIT_CAPACITY=100
NOTIFICATION_RATE_LIMIT_WINDOW=PT1M

# -----------------------------------------------------------------------------
#  Outbox publisher
# -----------------------------------------------------------------------------
NOTIFICATION_OUTBOX_POLL=PT1S

# -----------------------------------------------------------------------------
#  Web
# -----------------------------------------------------------------------------
SERVER_PORT=8080
NOTIFICATION_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
